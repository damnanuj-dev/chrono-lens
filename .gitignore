```gitignore
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/
coverage.xml

# Build / packaging
build/
dist/
*.egg-info/

# Logs
*.log
```
